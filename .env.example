# MatrixLLM configuration

# Server
PORT=11435
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth: comma-separated API keys accepted via:
#   Authorization: Bearer <key>
#   X-API-Key: <key>
API_KEYS=dev-key-change-me

# Rate limiting
RATE_LIMIT=60/minute

# Local Ollama (MatrixNode local runtime)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=deepseek-r1
DEFAULT_EMBED_MODEL=nomic-embed-text

# Relay fabric (optional)
RELAY_ENABLED=true
ENROLLMENT_SECRET=dev-enroll-change-me
ENROLLMENT_TTL_SECONDS=3600
LOCAL_RUNTIME_ENABLED=true
LOCAL_NODE_ID=local
LOCAL_NODE_TAGS=local

# Routing mode:
#  - prefix: use namespaced models like openai/<id>, anthropic/<id>, google/<id>, ibm/<id>, matrixnode/<id>
#  - fallback: always tries providers in a chain if configured
ROUTING_MODE=prefix

# OpenAI-compatible upstream (OpenAI/Azure OpenAI compat/OpenRouter-like/vLLM OpenAI server)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Gemini (AI Studio)
GEMINI_API_KEY=

# IBM watsonx.ai (native REST)
WATSONX_BASE_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_VERSION=2025-02-11

# Database
# If empty, uses SQLite under ~/.matrixllm/matrixllm.sqlite
DATABASE_URL=

# Client configuration (for notebooks and external clients)
# These are used by the demo notebooks to connect to the gateway
MATRIXLLM_BASE_URL=http://localhost:11435/v1
MATRIXLLM_API_KEY=
MATRIXLLM_MODEL=deepseek-r1

# ============================================================================
# Ollabridge compatibility (OLLAS_* prefixed variables)
# ============================================================================
# MatrixLLM supports ollabridge-compatible environment variables.
# These are aliases that allow seamless integration with tools expecting
# the OLLAS_* naming convention.
#
# OLLAS_API_KEY   -> alias for API_KEYS (server auth)
# OLLAS_BASE_URL  -> client base URL (http://localhost:11435/v1)
# OLLAS_MODEL     -> alias for DEFAULT_MODEL
#
# Example usage with OpenAI SDK:
#   from openai import OpenAI
#   client = OpenAI(
#       base_url=os.getenv("OLLAS_BASE_URL"),
#       api_key=os.getenv("OLLAS_API_KEY"),
#   )
#
# Uncomment to use ollabridge-style configuration:
# OLLAS_API_KEY=sk-matrixllm-your-key-here
# OLLAS_BASE_URL=http://localhost:11435/v1
# OLLAS_MODEL=deepseek-r1
